# Normalize line endings in the repository; check out platform-appropriate
# endings. Windows launchers must stay CRLF or cmd.exe can misread them.
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.ico binary
*.db binary
